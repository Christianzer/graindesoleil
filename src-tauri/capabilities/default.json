{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPCACHE/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPCACHE/**" }]
    }
  ]
}
